{
  "name": "espeho-erp-backend",
  "version": "1.0.0",
  "description": "ERP система за ЕСПЕХО ООД — стъклопакети и стъкло",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "node -e \"require('./src/db/migrate')().then(()=>process.exit(0)).catch(e=>{console.error(e);process.exit(1)})\"",
    "seed": "node src/db/seed.js",
    "setup": "npm run migrate && npm run seed",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.7",
    "pg": "^8.11.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
